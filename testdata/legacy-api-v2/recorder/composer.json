{
  "name": "hangar/legacy-corpus-recorder",
  "description": "Records eveseat/api v2 responses using the real Laravel 10 pipeline against the real eveapi schema.",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^10.0",
    "doctrine/dbal": "^3.0",
    "zircote/swagger-php": "^4.0",
    "lasserafn/php-initial-avatar-generator": "^4.2",
    "intervention/image": "^2.7"
  },
  "autoload": {
    "psr-4": {
      "Seat\\Api\\": "seat-api/src/",
      "Seat\\Eveapi\\": "seat-eveapi/src/",
      "Seat\\Services\\": "seat-services/src/",
      "Seat\\Web\\": "seat-web/src/",
      "Recorder\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "*": true
    }
  }
}
