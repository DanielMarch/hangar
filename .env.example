###############################################################################
# Project HANGAR — environment template
#
# Copy to `.env` and fill in. For the turnkey path (SRS §9.1) install.sh/.bat
# generates this file for you; a novice administrator should only ever have to
# supply HANGAR_SSO_CLIENT_ID and HANGAR_SSO_CLIENT_SECRET.
#
# Every key is also settable via config file or flag (Viper, internal/config).
# Precedence: flag > env > config file > default.
#
# Principle 8: secrets never leave the gateway. Anything marked SECRET is
# redacted by the slog handler and must never appear in a log line, a span
# attribute, an error message, or an API response.
###############################################################################

# ─────────────────────────────────────────────────────────────────────────────
# CORE
# ─────────────────────────────────────────────────────────────────────────────
# production | development
HANGAR_ENV=production
# debug | info | warn | error
HANGAR_LOG_LEVEL=info
# json | text  (text only for development)
HANGAR_LOG_FORMAT=json
HANGAR_HTTP_ADDR=0.0.0.0:8080
# must match the SSO callback origin exactly
HANGAR_PUBLIC_URL=http://localhost:8080
# comma-separated CIDRs; empty = trust none
HANGAR_TRUSTED_PROXIES=

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE — PostgreSQL 18 (SRS §3.1). Principle 7: this plus the binary is the
# entire required footprint.
# ─────────────────────────────────────────────────────────────────────────────
# SECRET
HANGAR_DB_URL=postgres://hangar:CHANGE_ME@postgres:5432/hangar?sslmode=disable
HANGAR_DB_MAX_CONNS=25
HANGAR_DB_MIN_CONNS=5
HANGAR_DB_MAX_CONN_LIFETIME=1h
HANGAR_DB_STATEMENT_TIMEOUT=30s
HANGAR_DB_APP_SCHEMA=app
HANGAR_DB_RIVER_SCHEMA=river
HANGAR_DB_SDE_SCHEMA=sde

# Used only by docker-compose.yml to initialise the bundled Postgres container.
POSTGRES_USER=hangar
# SECRET
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=hangar

# ─────────────────────────────────────────────────────────────────────────────
# REDIS — STRICTLY OPTIONAL (Principle 7). Leave empty for the two-service
# deployment. When set, it replaces the Postgres UNLOGGED L2 conditional cache
# only. It is never load-bearing for correctness; a cold Redis must degrade to a
# cache miss, never to an error.
# ─────────────────────────────────────────────────────────────────────────────
HANGAR_REDIS_URL=
HANGAR_REDIS_PREFIX=hangar

# ─────────────────────────────────────────────────────────────────────────────
# CRYPTO — envelope encryption for at-rest refresh tokens (Principle 8, §4.5)
# Generate with:  openssl rand -base64 32
# Rotation: append the new key as v2 and keep v1 for unwrapping. Never remove a
# key version that still has rows referencing it.
# ─────────────────────────────────────────────────────────────────────────────
# SECRET — base64, 32 bytes, REQUIRED
HANGAR_MASTER_KEY=
HANGAR_MASTER_KEY_VERSION=1
# SECRET — base64; set during rotation only
HANGAR_MASTER_KEY_PREVIOUS=

# Signs session cookies and third-party API tokens.
# SECRET — base64, 32 bytes, REQUIRED
HANGAR_SESSION_SECRET=
HANGAR_SESSION_TTL=720h
HANGAR_SESSION_COOKIE_SECURE=true

# ─────────────────────────────────────────────────────────────────────────────
# EVE SSO — OAuth 2.0 Authorization Code + PKCE S256 (SRS §3.1, §4.8)
# Register at https://developers.eveonline.com/applications
# The callback MUST be exactly ${HANGAR_PUBLIC_URL}/auth/callback.
# ─────────────────────────────────────────────────────────────────────────────
HANGAR_SSO_CLIENT_ID=
# SECRET
HANGAR_SSO_CLIENT_SECRET=
HANGAR_SSO_CALLBACK_URL=http://localhost:8080/auth/callback
HANGAR_SSO_AUTHORIZE_URL=https://login.eveonline.com/v2/oauth/authorize
HANGAR_SSO_TOKEN_URL=https://login.eveonline.com/v2/oauth/token
HANGAR_SSO_JWKS_URL=https://login.eveonline.com/oauth/jwks
HANGAR_SSO_ISSUERS=login.eveonline.com,https://login.eveonline.com
HANGAR_SSO_AUDIENCE=EVE Online
HANGAR_SSO_JWKS_REFRESH_INTERVAL=12h
# rate limit for unknown-kid triggered refetch
HANGAR_SSO_JWKS_MIN_REFETCH_INTERVAL=5m
HANGAR_SSO_CLOCK_SKEW=60s
# Token verification is OFFLINE ONLY (§4.8). /verify was removed 2026-04-28.
# There is deliberately no HANGAR_SSO_VERIFY_URL key.

# ─────────────────────────────────────────────────────────────────────────────
# ESI GATEWAY (SRS §4.1)
# ─────────────────────────────────────────────────────────────────────────────
HANGAR_ESI_BASE_URL=https://esi.evetech.net
HANGAR_ESI_USER_AGENT=HANGAR/1.0 (admin@example.com; +https://github.com/hangar-project/hangar)

# THE APP PIN. Used for every DATA request. Advanced ONLY by administrator action
# through POST /api/v1/admin/esi/catalogue/pin — never automatically (Principle 12).
# The runtime value lives in app.setting; this is the bootstrap seed only.
HANGAR_ESI_COMPATIBILITY_DATE=2026-08-04

# Discovery is deliberately NOT pinned. The OpenAPI spec is fetched at D_max, the
# newest value from /meta/compatibility-dates. Setting this to true is a debug
# escape hatch that WILL blind the catalogue to routes newer than the pin.
HANGAR_ESI_DISCOVERY_USE_APP_PIN=false

# global floor; overrides x-cache-age: 0 (§4.2.2)
HANGAR_ESI_TTL_FLOOR=300s
# cap for 1.5^n adaptive backoff on 304s
HANGAR_ESI_BACKOFF_CAP=4h
# §4.1.4 page-based fan-out cap
HANGAR_ESI_MAX_PAGE_CONCURRENCY=4
# HANGAR always requests the max (10..100)
HANGAR_ESI_CURSOR_LIMIT=100
HANGAR_ESI_REQUEST_TIMEOUT=30s
# 256 MiB ristretto budget
HANGAR_ESI_L1_CACHE_MAX_COST=268435456
# L2 row retained 4x the route TTL
HANGAR_ESI_L2_CACHE_TTL_MULTIPLIER=4

# Floating-window consumption ledger (§4.1.3). A continuous-refill token bucket
# is PROHIBITED. There is deliberately no "refill rate" key.
# worst-case predictive reservation
HANGAR_ESI_LEDGER_RESERVE_COST=5
# 0 = runtime.NumCPU()*4 (solo mode only)
HANGAR_ESI_LEDGER_SHARDS=0
#
# There is deliberately NO ledger mode or replica-divisor key. ESI enforces the
# consumption budget installation-wide, so HANGAR accounts for it
# installation-wide: the ledger is cluster-shared through Postgres, and the
# in-process fast path is selected automatically when exactly one replica is
# live. Scale out and the mode follows — nothing to set, nothing to get wrong.
# See docs/01_ARCHITECTURE.md §5.6.
HANGAR_REPLICA_HEARTBEAT_INTERVAL=10s
HANGAR_REPLICA_LIVENESS_TTL=30s

# Error-limit governor (§4.1.3 Governor 2). Installation-wide, cluster-shared via
# Postgres. Resume is deliberately higher than pause: without the hysteresis gap
# the installation oscillates in and out of pause.
HANGAR_ESI_ERROR_LIMIT_PAUSE_THRESHOLD=20
HANGAR_ESI_ERROR_LIMIT_RESUME_THRESHOLD=60

# Circuit breaker (§4.1.6)
HANGAR_ESI_BREAKER_5XX_THRESHOLD=10
HANGAR_ESI_BREAKER_403_THRESHOLD=5

# ─────────────────────────────────────────────────────────────────────────────
# SYNC ENGINE (SRS §4.2)
# ─────────────────────────────────────────────────────────────────────────────
HANGAR_SYNC_PLANNER_INTERVAL=5s
# full | none  (none is test-only)
HANGAR_SYNC_JITTER=full
# Rows claimed per 5s tick (db/queries/sync_subscription.sql ClaimDueSubscriptions)
HANGAR_SYNC_CLAIM_BATCH_SIZE=500
# How far a just-claimed subscription's next_due_at is pushed out — the
# claim transaction's own defence against re-claiming before the attempt
# finishes; River's unique-job option is the second line, not the first.
HANGAR_SYNC_CLAIM_LEASE=2m
# Ceiling on the 1.5^n consecutive-304 backoff (event-based cache mode)
HANGAR_SYNC_BACKOFF_CAP=24h
HANGAR_WORKER_QUEUES=default:20,esi-high:10,esi-bulk:40,provision-urgent:32,provision-bulk:8,alerting:16,sde:2
HANGAR_SDE_URL=https://developers.eveonline.com/static-data/tranquility/latest.jsonl.bz2
HANGAR_SDE_AUTO_IMPORT=false

# ─────────────────────────────────────────────────────────────────────────────
# ACCESS PROVISIONING — DISCORD (SRS §4.3)
# ─────────────────────────────────────────────────────────────────────────────
HANGAR_DISCORD_ENABLED=false
# SECRET
HANGAR_DISCORD_BOT_TOKEN=
HANGAR_DISCORD_CLIENT_ID=
# SECRET — OAuth2 guilds.join linking
HANGAR_DISCORD_CLIENT_SECRET=
HANGAR_DISCORD_GUILD_ID=
# must appear in the allowlist below
HANGAR_DISCORD_API_VERSION=10
HANGAR_DISCORD_API_VERSION_ALLOWLIST=10
# requests/second, hard ceiling
HANGAR_DISCORD_GLOBAL_RATE=50
# per rolling 10 minutes (Cloudflare)
HANGAR_DISCORD_INVALID_BUDGET=10000
HANGAR_DISCORD_INVALID_WARN_PCT=50
HANGAR_DISCORD_INVALID_PAUSE_PCT=80

# ─────────────────────────────────────────────────────────────────────────────
# ACCESS PROVISIONING — TEAMSPEAK 3 (SRS §4.3)
# ─────────────────────────────────────────────────────────────────────────────
HANGAR_TEAMSPEAK_ENABLED=false
HANGAR_TEAMSPEAK_WEBQUERY_URL=http://teamspeak:10080
# SECRET — WebQuery x-api-key
HANGAR_TEAMSPEAK_API_KEY=
HANGAR_TEAMSPEAK_VIRTUAL_SERVER_ID=1
# single-use challenge token lifetime
HANGAR_TEAMSPEAK_TOKEN_TTL=24h

# ─────────────────────────────────────────────────────────────────────────────
# ACCESS PROVISIONING — MUMBLE (SRS §4.3)
# ─────────────────────────────────────────────────────────────────────────────
HANGAR_MUMBLE_ENABLED=false
HANGAR_MUMBLE_GRPC_ADDR=mumble:50051
HANGAR_MUMBLE_SERVER_ID=1
# path; empty = insecure channel (LAN only)
HANGAR_MUMBLE_TLS_CA=
# true = absolute connection denial
HANGAR_MUMBLE_EXTERNAL_AUTHENTICATOR=false
# SECRET — signs POST /api/v1/public/mumble/auth
HANGAR_MUMBLE_AUTH_SHARED_SECRET=
# Fail closed (deny all connections) when HANGAR is unreachable in
# external-authenticator mode. Opt-in: defaulting to true would lock every user
# out during a HANGAR restart.
HANGAR_MUMBLE_AUTH_FAIL_CLOSED=false
# ZeroC Ice is NOT linked into the binary — no maintained Go binding exists and
# CGO would break the static builds of SRS §9.2. Point this at the optional
# `hangar-mumble-ice-bridge` container, which speaks the same gRPC contract.
HANGAR_MUMBLE_ICE_BRIDGE_ADDR=

# ─────────────────────────────────────────────────────────────────────────────
# ALERT DELIVERY CHANNELS (SRS §4.4)
# ─────────────────────────────────────────────────────────────────────────────
# Channels live in app.alert_channel, not here. The three endpoints below are
# a convenience: when set, `hangar work` provisions ONE matching "default-*"
# channel row at boot so a fresh installation can deliver without an operator
# writing SQL. An existing row is never overwritten from the environment, and
# no ROUTING RULES are created — who receives what is an operator decision.
HANGAR_SMTP_ENABLED=false
HANGAR_SMTP_HOST=
HANGAR_SMTP_PORT=587
HANGAR_SMTP_USERNAME=
# SECRET
HANGAR_SMTP_PASSWORD=
HANGAR_SMTP_FROM=hangar@example.com
# PHASE 14 ADDITION — comma-separated recipient list, required when
# HANGAR_SMTP_ENABLED=true. This key did not exist before: §4.4 describes
# per-user email routing, but app.user has no email column and EVE SSO never
# supplies one, so there is nothing to resolve a user target to an address
# with. An installation-wide recipient list is what can honestly be delivered
# today.
#
# PHASE 14.1 recorded this as a KNOWN LIMITATION in SRS §4.4 rather than
# closing it. Closing it needs an app.user.email column AND an
# address-verification flow — an unverified address is a delivery target and
# therefore an abuse vector — which is a phase of its own. Until then, a
# routing rule with target_kind='user' should point at a chat channel, which
# identifies a user by a platform handle they have already linked.
HANGAR_SMTP_TO=
# starttls | tls | none  ("tls" is SMTPS — TLS from the first byte, usually
# port 465 — which is a different wire protocol from STARTTLS, not a stricter
# version of it.)
HANGAR_SMTP_TLS=starttls

# SECRET — https://hooks.slack.com/services/...
HANGAR_SLACK_DEFAULT_WEBHOOK=
# SECRET
HANGAR_DISCORD_DEFAULT_WEBHOOK=

HANGAR_ALERT_COALESCE_WINDOW=300s
HANGAR_ALERT_MAX_ATTEMPTS=8
HANGAR_ALERT_DEAD_LETTER_AFTER=24h
# PHASE 14 ADDITIONS. CLAIM_SIZE must exceed the largest expected coalescing
# group: a roll-up is assembled from the deliveries claimed in ONE pass, so a
# group split across two claims would send two messages instead of one.
HANGAR_ALERT_DISPATCH_INTERVAL=15s
HANGAR_ALERT_CLAIM_SIZE=500
# First retry delay; each subsequent retry doubles it, capped.
HANGAR_ALERT_RETRY_BASE=60s
HANGAR_ALERT_RETRY_CAP=1h

# ─────────────────────────────────────────────────────────────────────────────
# OUTBOUND WEBHOOKS (SRS §4.9) — the sole out-of-process extension mechanism
# ─────────────────────────────────────────────────────────────────────────────
HANGAR_WEBHOOK_ENABLED=true
HANGAR_WEBHOOK_TIMEOUT=10s
HANGAR_WEBHOOK_MAX_ATTEMPTS=6

# ─────────────────────────────────────────────────────────────────────────────
# /api/v2 SUNSET SHIM (SRS §10, Gate 7)
# ─────────────────────────────────────────────────────────────────────────────
HANGAR_APIV2_SHIM_ENABLED=true
# RFC 8594 Sunset header value; set at release
HANGAR_APIV2_SUNSET_DATE=

# ─────────────────────────────────────────────────────────────────────────────
# LOCALISATION (SRS §4.6)
# ─────────────────────────────────────────────────────────────────────────────
# one of: af de en fr ja ko ro ru zh-CN
HANGAR_DEFAULT_LOCALE=en

# ─────────────────────────────────────────────────────────────────────────────
# OBSERVABILITY
# ─────────────────────────────────────────────────────────────────────────────
HANGAR_METRICS_ENABLED=true
HANGAR_METRICS_ADDR=127.0.0.1:9090
HANGAR_OTEL_EXPORTER_OTLP_ENDPOINT=
HANGAR_OTEL_SERVICE_NAME=hangar
HANGAR_OTEL_TRACE_SAMPLE_RATIO=0.05
