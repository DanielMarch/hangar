/data/
/tmp/
*.sqlite
*.jsonl
*.jsonl.bz2
!testdata/**/*.jsonl

# ── editors / OS ─────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
